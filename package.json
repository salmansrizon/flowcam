{
  "name": "flowcam",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test:unit && npm run test:integration",
    "test:unit": "vitest run",
    "test:integration": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "^1",
    "@types/node": "^24.19.2",
    "typescript": "^5",
    "vitest": "^5.0.5"
  }
}
