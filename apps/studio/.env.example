# Supabase project (flowcam). The URL and publishable key are safe in the browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server only: grants Credits and plans, and creates test sessions. Never expose or commit it.
SUPABASE_SECRET_KEY=
# OpenRouter for AI Jobs (server only). "demo" uses local fake results until the real key is added.
OPENROUTER_API_KEY=demo

# Share Links video hosting (server only). "demo" stores MP4s in Supabase Storage until the real Mux keys are added.
MUX_TOKEN_ID=demo
MUX_TOKEN_SECRET=demo
# Billing (server only). "demo" uses a local fake checkout that sends signed test webhooks; production refuses it.
LEMONSQUEEZY_API_KEY=demo
LEMONSQUEEZY_STORE_ID=demo
LEMONSQUEEZY_WEBHOOK_SECRET=demo
