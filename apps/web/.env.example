# Copy to .env.local for local development. Set the same names in Vercel.
SUPABASE_URL=https://your-project-ref.supabase.co
# Secret (service role) key: server only, never NEXT_PUBLIC_
SUPABASE_SECRET_KEY=
# Pro launch moment for the /waitlist countdown (ISO date, or date-time with Z or an offset). Unset or invalid: "Coming soon".
NEXT_PUBLIC_PRO_LAUNCH_AT=
# The Studio's origin, for "Try Flowcam free".
NEXT_PUBLIC_STUDIO_URL=http://localhost:3000
